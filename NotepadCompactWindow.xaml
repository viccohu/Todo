<Window
    x:Class="Memo.NotepadCompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Memo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="32" PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <ImageIcon Source="ms-appx:///Assets/icons/white/记事本.svg" Width="18" Height="18"/>
                <TextBlock Text="NOTEPAD" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Click="RestoreButton_Click"
                    Background="Transparent"
                    Margin="0,0,8,0"
                    BorderThickness="0"
                    Padding="4"
                    ToolTipService.ToolTip="恢复">
                <FontIcon Glyph="&#xE196;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Button>
        </Grid>

        <!-- Tab 标签栏 -->
        <TabView x:Name="NotepadTabView"
                 Grid.Row="1"
                 AddTabButtonClick="TabView_AddTabClick"
                 TabCloseRequested="TabView_TabCloseRequested"
                 SelectionChanged="TabView_SelectionChanged"
                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 IsAddTabButtonVisible="True">
        </TabView>

        <!-- 可折叠区域（工具栏+内容） -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="6,4" Height="32">
                    <Button x:Name="PreviewToggleButton"
                            Click="PreviewToggle_Click"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="4,2"
                            ToolTipService.ToolTip="切换预览/编辑">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="PreviewToggleIcon" Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PreviewToggleText" Text="编辑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 内容区（IsReadOnly 切换预览/编辑） -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="Editor"
                             TextWrapping="Wrap"
                             Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="200"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderThickness="0"
                             Padding="12,8,12,8"
                             KeyDown="Editor_KeyDown"
                             TextChanged="Editor_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource TextFillColorPrimary}"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource TextFillColorPrimary}"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource TextFillColorTertiary}"/>
                        </TextBox.Resources>
                    </TextBox>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <!-- 误关闭恢复提示 -->
        <Grid x:Name="UndoBar" Grid.Row="3" Height="36" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="Collapsed" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UndoText" Grid.Column="0" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <Button Grid.Column="1" Click="UndoClose_Click" Background="Transparent" BorderThickness="0" Padding="8,4" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12">
                恢复
            </Button>
        </Grid>

        <!-- 展开/收起按钮 -->
        <Button x:Name="ToggleExpandButton"
                Grid.Row="4"
                Click="ToggleExpand_Click"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="0"
                Padding="0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon x:Name="ToggleExpandIcon" Glyph="&#xE96E;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
