<Window x:Class="Memo.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Memo">
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="TaskRowTemplate">
                <Grid MinHeight="40" ColumnSpacing="6" ToolTipService.ToolTip="{Binding Title}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click"
                              AutomationProperties.Name="{Binding Title}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding DueDateShortDisplay}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{Binding DateLabelForeground}"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="Transparent" PointerPressed="Bounds_PointerPressed" PointerMoved="Bounds_PointerMoved"
                    PointerReleased="Bounds_PointerReleased" PointerCaptureLost="Bounds_PointerCaptureLost"
                    DoubleTapped="TitleBar_DoubleTapped" ToolTipService.ToolTip="拖动移动，双击收起或展开">
                <TextBlock Text="任务中心" FontSize="14" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center"/>
            </Border>
            <Button Grid.Column="1" Click="ToggleExpand_Click" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="收起或展开" AutomationProperties.Name="收起或展开">
                <FontIcon x:Name="CompactToggleIcon" Glyph="&#xE70E;" FontSize="12"/>
            </Button>
            <Button Grid.Column="2" Click="RestoreButton_Click" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="恢复正常窗口" AutomationProperties.Name="恢复正常窗口" Margin="0,0,8,0">
                <FontIcon Glyph="&#xE196;" FontSize="14"/>
            </Button>
        </Grid>
        <Grid x:Name="MatrixPanel" Grid.Row="1" Margin="10,0,10,0" RowSpacing="10" ColumnSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Padding="8,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Q1 · 重要且紧急" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Q1Count" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="立即处理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Q1List" ItemTemplate="{StaticResource TaskRowTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="Q1Empty" Grid.Row="1" Text="暂无任务" FontSize="12" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Padding="10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Padding="8,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Q2 · 重要不紧急" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Q2Count" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="计划安排" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Q2List" ItemTemplate="{StaticResource TaskRowTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="Q2Empty" Grid.Row="1" Text="暂无任务" FontSize="12" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Padding="10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Padding="8,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Q3 · 紧急不重要" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Q3Count" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="快速处理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Q3List" ItemTemplate="{StaticResource TaskRowTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="Q3Empty" Grid.Row="1" Text="暂无任务" FontSize="12" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Padding="10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Padding="8,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Q4 · 不重要不紧急" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Q4Count" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="可暂缓" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Q4List" ItemTemplate="{StaticResource TaskRowTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="Q4Empty" Grid.Row="1" Text="暂无任务" FontSize="12" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="ResizeGrip" Grid.Row="2" Width="28" HorizontalAlignment="Right" Background="Transparent"
                PointerPressed="Bounds_PointerPressed" PointerMoved="Bounds_PointerMoved"
                PointerReleased="Bounds_PointerReleased" PointerCaptureLost="Bounds_PointerCaptureLost"
                ToolTipService.ToolTip="拖动调整大小">
            <FontIcon Glyph="&#xE784;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Border>
    </Grid>
</Window>
