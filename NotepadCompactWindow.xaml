<Window
    x:Class="Memo.NotepadCompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Memo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="40" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="Transparent" PointerPressed="TitleBar_PointerPressed" PointerMoved="TitleBar_PointerMoved"
                    PointerReleased="TitleBar_PointerReleased" PointerCaptureLost="TitleBar_PointerCaptureLost"
                    DoubleTapped="TitleBar_DoubleTapped" ToolTipService.ToolTip="拖动移动，双击收起或展开">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <ImageIcon Source="ms-appx:///Assets/icons/white/记事本.svg" Width="18" Height="18"/>
                <TextBlock Text="NOTEPAD" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            </Border>
            <Button x:Name="ToggleExpandButton" Grid.Column="1" Click="ToggleExpand_Click"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="收起或展开" AutomationProperties.Name="收起或展开">
                <FontIcon x:Name="ToggleExpandIcon" Glyph="&#xE70E;" FontSize="12"/>
            </Button>
            <Button Grid.Column="2"
                    Click="RestoreButton_Click"
                    Background="Transparent"
                    Margin="0,0,8,0"
                    BorderThickness="0"
                    Padding="4"
                    ToolTipService.ToolTip="恢复">
                <FontIcon Glyph="&#xE196;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Button>
        </Grid>

        <!-- Tab 标签栏 -->
        <TabView x:Name="NotepadTabView"
                 Grid.Row="1"
                 AddTabButtonClick="TabView_AddTabClick"
                 TabCloseRequested="TabView_TabCloseRequested"
                 SelectionChanged="TabView_SelectionChanged"
                 Background="Transparent"
                 IsAddTabButtonVisible="True">
        </TabView>

        <!-- 可折叠区域（工具栏+内容） -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Background="Transparent" Padding="6,4" Height="32" Visibility="Collapsed">
                    <Button x:Name="PreviewToggleButton"
                            Click="PreviewToggle_Click"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="4,2"
                            IsTabStop="False" UseSystemFocusVisuals="False"
                            ToolTipService.ToolTip="切换预览/编辑">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="PreviewToggleIcon" Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PreviewToggleText" Text="编辑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 内容区（IsReadOnly 切换预览/编辑） -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                    <local:NotepadEditTextBox x:Name="Editor"
                             TextWrapping="Wrap"
                             MinHeight="200"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderThickness="0"
                             Padding="12,8,12,8"
                             TextChanged="Editor_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource TextFillColorSecondary}"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource TextFillColorSecondary}"/>
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource TextFillColorSecondary}"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource TextFillColorTertiary}"/>
                        </TextBox.Resources>
                    </local:NotepadEditTextBox>
                    <!-- 预览层：有链接时把链接渲染为 Hyperlink（纯文本元素，支持选择复制且无
                         InlineUIContainer + 文本选择的崩溃问题，见 microsoft-ui-xaml #5646） -->
                    <Grid x:Name="PreviewDisplayHost"
                          Visibility="Collapsed"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <RichTextBlock x:Name="PreviewDisplay"
                                       Padding="12,8,12,8"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       IsTabStop="False"/>
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <!-- 误关闭恢复提示 -->
        <Grid x:Name="UndoBar" Grid.Row="3" Height="36" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="Collapsed" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UndoText" Grid.Column="0" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <Button Grid.Column="1" Click="UndoClose_Click" Background="Transparent" BorderThickness="0" Padding="8,4" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12">
                恢复
            </Button>
        </Grid>

        <Border x:Name="ResizeGrip" Grid.Row="4" Width="28" Height="20" HorizontalAlignment="Right"
                Background="Transparent"
                PointerPressed="TitleBar_PointerPressed" PointerMoved="TitleBar_PointerMoved"
                PointerReleased="TitleBar_PointerReleased" PointerCaptureLost="TitleBar_PointerCaptureLost"
                ToolTipService.ToolTip="拖动调整记事本大小">
            <FontIcon Glyph="&#xE784;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Border>
    </Grid>
</Window>
