<Window
    x:Class="Todo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Todo"
    xmlns:models="using:Todo.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#161616">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#1c1c1c" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftDragColumn" Width="*"/>
                <ColumnDefinition x:Name="ButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="TitleBarIcon" 
                      Glyph="&#xE8C8;" 
                      FontSize="14" 
                      Foreground="#0078d4" 
                      Grid.Column="1" 
                      Margin="8,0,4,0" 
                      VerticalAlignment="Center"/>
            
            <TextBlock x:Name="TitleBarTextBlock" 
                       Text="待办事项" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontWeight="SemiBold"/>

            <Grid x:Name="DragRegion" Grid.Column="3"/>

            <Button Click="ToggleDesktopMode_Click" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="8,4"
                    Grid.Column="4">
                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="#888"/>
            </Button>
        </Grid>

        <!-- NavigationView 主内容区 -->
        <Grid Grid.Row="1">
            <NavigationView x:Name="NavView"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Left"
                            OpenPaneLength="260"
                            CompactPaneLength="60"
                            Background="#1c1c1c"
                            SelectionChanged="NavView_SelectionChanged">
                
      

                <!-- 固定导航项 -->
                <NavigationView.MenuItems>
                    <!-- 日历视图 -->
                    <NavigationViewItem Content="日历视图" Tag="Calendar">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Calendar"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <!-- 重要任务 -->
                    <NavigationViewItem Content="重要任务" Tag="Important">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Favorite"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <!-- 常驻任务（可展开） -->
                    <NavigationViewItem Content="常驻任务" Tag="Recurring" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Clock"/>
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.MenuItems>
                            <NavigationViewItem Content="日常" Tag="Daily">
                                <NavigationViewItem.Icon>
                                    <SymbolIcon Symbol="CalendarDay"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="周常" Tag="Weekly">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE817;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="月常" Tag="Monthly">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE817;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>
                    
                    <!-- 分隔线 -->
                    <NavigationViewItemSeparator/>
                    
                    <!-- 自定义分组区域（动态加载） -->
                    <NavigationViewItemHeader Content="自定义"/>
                </NavigationView.MenuItems>

                <!-- 底部按钮 -->
                <NavigationView.FooterMenuItems>
                    <NavigationViewItemSeparator/>
                </NavigationView.FooterMenuItems>

                <!-- 自定义 Footer -->
                <NavigationView.PaneFooter>
                    <Grid Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                            <Button x:Name="NewListButton" 
                                    Click="NewList_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,8"
                                    CornerRadius="4"
                                    HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#0078d4"/>
                                    <TextBlock Text="新建列表" FontSize="12" Foreground="#ccc"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NewGroupButton" 
                                    Click="NewGroup_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12,8"
                                    CornerRadius="4"
                                    HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#0078d4"/>
                                    <TextBlock Text="新建分组" FontSize="12" Foreground="#ccc"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </NavigationView.PaneFooter>

                <!-- 内容区域 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主内容区 -->
                    <ScrollViewer Grid.Column="0" Background="#161616">
                        <Grid x:Name="ContentArea" Padding="40,20,40,40">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,30">
                                    <FontIcon x:Name="PageIcon" Glyph="&#xE8C8;" FontSize="28" Foreground="White"/>
                                    <TextBlock x:Name="PageTitle" Text="重要任务" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                                <ItemsControl x:Name="TasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Height="60" Margin="0,0,0,10" Background="#1e1e1e">
                                                <Grid Margin="15,0">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" Margin="5,0,0,0"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding DueDate}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="CompletedButton" Margin="0,20,0,10" Background="#262626" BorderThickness="0" CornerRadius="4" Padding="8,4" Click="ToggleCompleted_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE787;" FontSize="12"/>
                                        <TextBlock x:Name="CompletedText" Text="已完成" FontSize="12"/>
                                        <FontIcon x:Name="CompletedArrow" Glyph="&#xE70D;" FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl x:Name="CompletedTasksList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Height="60" Margin="0,0,0,10" Background="#1e1e1e" Opacity="0.6">
                                                <Grid Margin="15,0">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                        <TextBlock Text="{Binding Title}" TextDecorations="Strikethrough" Foreground="#888"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding DueDate}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#555" FontSize="12"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Height="60" Margin="0,10,0,0">
                                    <Button Click="AddTask_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0">
                                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="#0078d4"/>
                                            <TextBlock Text="添加任务" Foreground="#0078d4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 右侧详情面板 -->
                    <Grid x:Name="DetailPanel" Grid.Column="1" Background="#161616" BorderBrush="#2a2a2a" BorderThickness="1,0,0,0" Padding="20">
                        <StackPanel Spacing="20">
                            <Border Background="#222" CornerRadius="12" Padding="15">
                                <StackPanel Spacing="15">
                                    <Grid>
                                        <CheckBox Content="制定计划书" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <FontIcon Glyph="&#xE712;" HorizontalAlignment="Right" FontSize="14" Foreground="#888"/>
                                    </Grid>
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <CheckBox IsChecked="True" Content="梳理" FontSize="13" Foreground="#888"/>
                                            <TextBlock Text="2026年1月1日" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#555"/>
                                        </Grid>
                                        <CheckBox Content="对接" FontSize="13" Foreground="#eee"/>
                                        <Button Content="+ 添加任务拆分" Background="Transparent" BorderThickness="0" Foreground="#0078d4" Padding="0" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#222" CornerRadius="12" Padding="15" Height="120">
                                <TextBlock Text="添加备注" Foreground="#888" FontSize="13"/>
                            </Border>

                            <Border Background="#222" CornerRadius="12">
                                <StackPanel>
                                    <Grid Height="48" Padding="15,0" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1">
                                        <TextBlock Text="提醒我" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Height="48" Padding="15,0" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1">
                                        <TextBlock Text="添加截止时间 *" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Height="48" Padding="15,0">
                                        <TextBlock Text="重复" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
