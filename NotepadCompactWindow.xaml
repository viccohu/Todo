<Window
    x:Class="Todo.NotepadCompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Todo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="32" PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <ImageIcon Source="ms-appx:///Assets/icons/white/记事本.svg" Width="18" Height="18"/>
                <TextBlock Text="NOTEPAD" FontSize="14" Foreground="#ccc" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Click="RestoreButton_Click"
                    Background="Transparent"
                    Margin="0,0,8,0"
                    BorderThickness="0"
                    Padding="4"
                    ToolTipService.ToolTip="恢复">
                <FontIcon Glyph="&#xE196;" FontSize="14" Foreground="#888"/>
            </Button>
        </Grid>

        <!-- Tab 标签栏 -->
        <TabView x:Name="NotepadTabView"
                 Grid.Row="1"
                 AddTabButtonClick="TabView_AddTabClick"
                 TabCloseRequested="TabView_TabCloseRequested"
                 SelectionChanged="TabView_SelectionChanged"
                 Background="#1e1e1e"
                 IsAddTabButtonVisible="True">
        </TabView>

        <!-- 可折叠区域（工具栏+内容） -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Background="#222" Padding="6,4" Height="32">
                    <Button x:Name="PreviewToggleButton"
                            Click="PreviewToggle_Click"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Padding="4,2"
                            ToolTipService.ToolTip="切换预览/编辑">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="PreviewToggleIcon" Glyph="&#xE70F;" FontSize="14" Foreground="#ccc"/>
                            <TextBlock x:Name="PreviewToggleText" Text="编辑" FontSize="12" Foreground="#ccc" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 内容区 -->
                <Grid Grid.Row="1">
                    <TextBox x:Name="Editor"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="200"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Visibility="Collapsed"
                             Foreground="#e0e0e0"
                             Background="#1e1e1e"
                             BorderThickness="0"
                             Padding="12,8,12,8"
                             KeyDown="Editor_KeyDown"
                             TextChanged="Editor_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackground" Color="#1e1e1e"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1e1e1e"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1e1e1e"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="#e0e0e0"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#e0e0e0"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#555"/>
                            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                        </TextBox.Resources>
                    </TextBox>

                    <ScrollViewer x:Name="PreviewContainer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="Preview"
                                 IsReadOnly="True"
                                 Text="{Binding Content, Mode=OneWay}"
                                 Padding="12,8,12,8"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Background="#1e1e1e"
                                 Foreground="#e0e0e0"
                                 BorderThickness="0"
                                 KeyDown="Preview_KeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackground" Color="#1e1e1e"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1e1e1e"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1e1e1e"/>
                                <SolidColorBrush x:Key="TextControlForeground" Color="#e0e0e0"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#e0e0e0"/>
                            </TextBox.Resources>
                        </TextBox>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 展开/收起按钮 -->
        <Button x:Name="ToggleExpandButton"
                Grid.Row="3"
                Click="ToggleExpand_Click"
                HorizontalAlignment="Stretch"
                Background="#262626"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="0"
                Padding="0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon x:Name="ToggleExpandIcon" Glyph="&#xE96E;" FontSize="12" Foreground="#888"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
