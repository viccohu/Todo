<Window
    x:Class="Todo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Todo"
    xmlns:models="using:Todo.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#161616">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#1c1c1c" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftDragColumn" Width="*"/>
                <ColumnDefinition x:Name="ButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="TitleBarIcon" 
                      Glyph="&#xE8C8;" 
                      FontSize="14" 
                      Foreground="#0078d4" 
                      Grid.Column="1" 
                      Margin="8,0,4,0" 
                      VerticalAlignment="Center"/>
            
            <TextBlock x:Name="TitleBarTextBlock" 
                       Text="待办事项" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontWeight="SemiBold"/>

            <Grid x:Name="DragRegion" Grid.Column="3"/>

            <Button x:Name="PinButton" Click="ToggleDesktopMode_Click" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="8,4"
                    Grid.Column="4"
                    ToolTipService.ToolTip="固定到桌面">
                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="14" Foreground="#888"/>
            </Button>
        </Grid>

        <!-- 正常模式：NavigationView 主内容区 -->
        <Grid x:Name="NormalContent" Grid.Row="1">
            <NavigationView x:Name="NavView"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Left"
                            OpenPaneLength="260"
                            CompactPaneLength="60"
                            Background="#1c1c1c"
                            PaneOpened="NavView_PaneOpened"
                            PaneClosed="NavView_PaneClosed"
                            ItemInvoked="NavView_ItemInvoked"
                            SelectionChanged="NavView_SelectionChanged">
                
                <!-- 固定导航项 -->
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="记事本" Tag="Notepad">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE70F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <NavigationViewItem Content="重要任务" Tag="Important">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Favorite"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <NavigationViewItem Content="常驻任务" Tag="Recurring" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Clock"/>
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.MenuItems>
                            <NavigationViewItem Content="日常" Tag="Daily">
                                <NavigationViewItem.Icon>
                                    <SymbolIcon Symbol="CalendarDay"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="周常" Tag="Weekly">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE817;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="月常" Tag="Monthly">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE817;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>
                    
                    <NavigationViewItemSeparator/>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItemSeparator/>
                </NavigationView.FooterMenuItems>

                <NavigationView.PaneFooter>
                    <Grid x:Name="PaneFooterGrid" Padding="0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewListButton"
                                Grid.Column="0"
                                Click="NewList_Click"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,8"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#0078d4"/>
                                <TextBlock Text="新建列表" FontSize="12" Foreground="#ccc"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewGroupButton"
                                Grid.Column="1"
                                Click="NewGroup_Click"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,8"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#0078d4"/>
                                <TextBlock Text="新建分组" FontSize="12" Foreground="#ccc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </NavigationView.PaneFooter>

                <!-- 内容区域 - 使用 SplitView 实现抽屉 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主内容区 -->
                    <Grid Grid.Column="0" Background="#161616" PointerPressed="ContentArea_PointerPressed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 页面标题 -->
                        <StackPanel x:Name="PageHeader" Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="40,20,40,20">
                            <FontIcon x:Name="PageIcon" Glyph="&#xE8C8;" FontSize="28" Foreground="White"/>
                            <TextBlock x:Name="PageTitle" Text="重要任务" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>

                        <!-- 记事本页面 -->
                        <Grid x:Name="NotepadContent" Grid.Row="1" Visibility="Collapsed" Padding="4,0,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TabView 标签栏 -->
                           <TabView x:Name="NotepadTabView"
                                    Grid.Row="0"
                                     AddTabButtonClick="NotepadTabView_AddTabClick"
                                     TabCloseRequested="NotepadTabView_TabCloseRequested"
                                     SelectionChanged="NotepadTabView_SelectionChanged"
                                     SelectedIndex="0"
                                     Background="#161616"
                                     IsAddTabButtonVisible="True">
                            </TabView>

                            <!-- 工具栏 -->
                            <Grid x:Name="NotepadToolbar" Grid.Row="1" Background="#282828"
                                 Padding="8,4" BorderBrush="#333" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：文件操作 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="NotepadOpenButton"
                                            Click="NotepadOpen_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="打开文件">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="15" Foreground="#ccc"/>
                                    </Button>
                                    <Button x:Name="NotepadSaveButton"
                                            Click="NotepadSave_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="保存">
                                        <FontIcon Glyph="&#xE74E;" FontSize="15" Foreground="#ccc"/>
                                    </Button>
                                    <Button x:Name="NotepadSaveAsButton"
                                            Click="NotepadSaveAs_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="另存为">
                                        <FontIcon Glyph="&#xE792;" FontSize="15" Foreground="#ccc"/>
                                    </Button>
                                </StackPanel>

                                <!-- 右侧：预览/编辑切换 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="NotepadPreviewToggleButton"
                                            Click="NotepadPreviewToggle_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="切换预览/编辑">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon x:Name="NotepadPreviewToggleIcon" Glyph="&#xE70F;" FontSize="14" Foreground="#ccc"/>
                                            <TextBlock x:Name="NotepadPreviewToggleText" Text="编辑" FontSize="12" Foreground="#ccc" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 编辑器区 -->
                            <TextBox x:Name="NotepadEditor"
                                     Grid.Row="2"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Visibility="Collapsed"
                                     Foreground="#e0e0e0"
                                     Background="#161616"
                                     BorderThickness="0"
                                     Margin="0,0,0,0"
                                     Padding="24,8,24,8"
                                     KeyDown="NotepadEditor_KeyDown"
                                     TextChanged="NotepadEditor_TextChanged"
                                     LostFocus="NotepadEditor_LostFocus">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#555"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="#161616"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#161616"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#161616"/>
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#e0e0e0"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#e0e0e0"/>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- 只读预览区 -->
                            <ScrollViewer x:Name="NotepadPreviewContainer" Grid.Row="2" Padding="24,8,24,8"
                                          VerticalScrollBarVisibility="Auto"
                                          DoubleTapped="NotepadPreview_DoubleTapped">
                                <TextBox x:Name="NotepadPreview"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Background="#161616"
                                         Foreground="#e0e0e0"
                                         BorderThickness="0"
                                         DoubleTapped="NotepadPreview_DoubleTapped">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="#161616"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#161616"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#161616"/>
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#e0e0e0"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#e0e0e0"/>
                                    </TextBox.Resources>
                                </TextBox>
                            </ScrollViewer>
                        </Grid>

                        <!-- 任务列表 ScrollView -->
                        <ScrollViewer x:Name="TaskListScrollViewer" Grid.Row="1" Padding="40,0,40,0">
                            <StackPanel MinWidth="300" HorizontalAlignment="Stretch">
                                <ItemsControl x:Name="TasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Height="60" 
                                                    Margin="0,0,0,10" 
                                                    Background="#1e1e1e"
                                                    Loaded="TaskBorder_Loaded"
                                                    Unloaded="TaskBorder_Unloaded"
                                                    PointerPressed="TaskItem_PointerPressed"
                                                    PointerEntered="TaskItem_PointerEntered"
                                                    PointerExited="TaskItem_PointerExited"
                                                    RightTapped="TaskItem_RightTapped">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="删除任务" Icon="Delete" Click="DeleteTask_Click"/>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <Grid Margin="15,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                              Click="TaskCheckBox_Click"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}" 
                                                               Foreground="White" 
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2"
                                                               HorizontalAlignment="Right" 
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,0,0">
                                                        <TextBlock Foreground="#555" FontSize="10" HorizontalAlignment="Right" Text="{Binding CreatedAtDisplay}"/>
                                                        <TextBlock Foreground="#666" FontSize="10" HorizontalAlignment="Right" Text="{Binding DueDateShortDisplay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="CompletedButton" 
                                        Margin="0,10,0,10" 
                                        Background="#262626" 
                                        BorderThickness="0" 
                                        CornerRadius="4" 
                                        Padding="8,4" 
                                        Click="ToggleCompleted_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE787;" FontSize="12"/>
                                        <TextBlock x:Name="CompletedText" Text="已完成" FontSize="12"/>
                                        <FontIcon x:Name="CompletedArrow" Glyph="&#xE70D;" FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl x:Name="CompletedTasksList" Visibility="Collapsed" Opacity="0">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform x:Name="CompletedListTransform" Y="0"/>
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#333" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Height="60" 
                                                    Margin="0,0,0,10" 
                                                    Background="#1e1e1e" 
                                                    Opacity="0.6"
                                                    Loaded="TaskBorder_Loaded"
                                                    Unloaded="TaskBorder_Unloaded"
                                                    PointerPressed="TaskItem_PointerPressed"
                                                    PointerEntered="TaskItem_PointerEntered"
                                                    PointerExited="TaskItem_PointerExited"
                                                    RightTapped="TaskItem_RightTapped">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="删除任务" Icon="Delete" Click="DeleteTask_Click"/>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <Grid Margin="15,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="4"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Click="TaskCheckBox_Click"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               TextDecorations="Strikethrough"
                                                               Foreground="#666"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,0,0">
                                                        <TextBlock Foreground="#444" FontSize="10" HorizontalAlignment="Right" Text="{Binding CreatedAtDisplay}"/>
                                                        <TextBlock Foreground="#555" FontSize="10" HorizontalAlignment="Right" Text="{Binding DueDateShortDisplay}"/>
                                                    </StackPanel>
                                                    <Rectangle Grid.Column="3"
                                                               Fill="{Binding CompletionIndicatorBrush}"
                                                               VerticalAlignment="Stretch"
                                                               RadiusX="2" RadiusY="2"
                                                               Margin="0,2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 固定底部 - 添加任务 -->
                        <Grid x:Name="AddTaskBar" Grid.Row="2" Background="#161616" Padding="40,10,40,10">
                            <Grid x:Name="AddTaskContainer">
                                <!-- 按钮状态 -->
                                <Border x:Name="AddTaskButton" 
                                        BorderBrush="#333" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Height="60"
                                        HorizontalAlignment="Stretch"
                                        Visibility="Visible">
                                    <Button Click="ShowAddTaskInput_Click" 
                                            HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Stretch" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0">
                                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="#0078d4"/>
                                            <TextBlock Text="添加任务" Foreground="#777" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                
                                <!-- 输入框状态 -->
                                <Border x:Name="AddTaskInputArea"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="60"
                                        HorizontalAlignment="Stretch"
                                        Background="#1e1e1e"
                                        Visibility="Collapsed">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE710;" FontSize="18" Foreground="#0078d4" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AddTaskTextBox"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="14"
                                                 Foreground="#0078d4"
                                                 VerticalAlignment="Center"
                                                 Margin="12,0"
                                                 KeyDown="AddTaskInput_KeyDown">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="2"
                                                x:Name="AddTaskDueDateButton"
                                                Click="AddTaskDueDate_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="设置截止日期">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon x:Name="AddTaskDueDateIcon"
                                                          Glyph="&#xE787;"
                                                          FontSize="22"
                                                          Foreground="#555"/>
                                                <TextBlock x:Name="AddTaskDueDateText"
                                                           Text=""
                                                           Foreground="#0078d4"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Grid Padding="12" RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <CalendarView x:Name="AddTaskCalendarView"
                                                                      Grid.Row="0"
                                                                      Language="zh-CN"
                                                                      SelectedDatesChanged="AddTaskCalendarView_SelectedDatesChanged">
                                                            <CalendarView.Resources>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="#0078D4"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="#FFFFFF"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="#168DE2"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="#006CBE"/>
                                                                <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                                            </CalendarView.Resources>
                                                        </CalendarView>
                                                        <Button Grid.Row="1"
                                                                Content="清除日期"
                                                                Click="AddTaskClearDate_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#888"
                                                                FontSize="12"
                                                                HorizontalAlignment="Right"
                                                                Padding="8,4"/>
                                                    </Grid>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 右侧抽屉 - 任务详情 -->
                    <Grid x:Name="DetailDrawer" 
                          Grid.Column="1" 
                          Width="380"
                          Background="#1c1c1c" 
                          BorderBrush="#2a2a2a" 
                          BorderThickness="1,0,0,0"
                          Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTranslateTransform" X="380"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 抽屉标题 -->
                        <Grid Grid.Row="0" Height="32" Padding="16,0" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1">
                            
                            <Button Click="CloseDrawer_Click" 
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#888"/>
                            </Button>
                        </Grid>

                        <!-- 抽屉内容 -->
                        <ScrollViewer Grid.Row="1" Padding="16" x:Name="DrawerScrollViewer">
                            <StackPanel Spacing="0">
                                <!-- 任务标题（无背景） -->
                                <Grid Background="#222" CornerRadius="8,8,0,0" Padding="8,8,8,0">
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  x:Name="DetailCheckBox" 
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"
                                                  Click="DetailCheckBox_Click"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="DetailTitle" 
                                             Background="Transparent" 
                                             BorderThickness="0"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="White"
                                             Padding="0"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             TextChanged="DetailTitle_TextChanged">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                        </TextBox.Resources>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <ScrollViewer x:Name="ContentElement"
                                                                              VerticalScrollMode="Auto"
                                                                              VerticalScrollBarVisibility="Hidden"
                                                                              HorizontalScrollMode="Disabled"
                                                                              HorizontalScrollBarVisibility="Hidden"
                                                                              Padding="{TemplateBinding Padding}"
                                                                              Foreground="{TemplateBinding Foreground}"
                                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <!-- 子任务区（背景框） -->
                                <Border Background="#222" CornerRadius="0,0,8,8" Padding="8" Margin="0,0,0,12">
                                    <StackPanel Spacing="0">
                                        <!-- 子任务列表 -->
                                        <ItemsControl x:Name="SubTasksList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                  Click="SubTaskCheckBox_Click"
                                                                  RightTapped="SubTask_RightTapped"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Title, Mode=TwoWay}" 
                                                                 Background="Transparent" 
                                                                 BorderThickness="0"
                                                                 FontSize="13"
                                                                 Foreground="#ccc"
                                                                 Padding="0,0,0,0"
                                                                 Margin="8,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 TextChanged="SubTaskTitle_TextChanged"
                                                                 LostFocus="SubTaskTitle_LostFocus">
                                                            <TextBox.Resources>
                                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                                                <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                                            </TextBox.Resources>
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="TextBox">
                                                                                <Grid>
                                                                                    <ScrollViewer x:Name="ContentElement"
                                                                                                  VerticalScrollMode="Auto"
                                                                                                  VerticalScrollBarVisibility="Hidden"
                                                                                                  HorizontalScrollMode="Disabled"
                                                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                                                  Padding="{TemplateBinding Padding}"
                                                                                                  Foreground="{TemplateBinding Foreground}"
                                                                                                  AutomationProperties.AccessibilityView="Raw"/>
                                                                                </Grid>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <Button Grid.Column="2"
                                                                Click="DeleteSubTask_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#666"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- 添加子任务按钮/输入框 -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="AddSubTaskButton" 
                                                    Click="ShowAddSubTaskInput_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#0078d4"/>
                                                    <TextBlock Text="添加子任务" Foreground="#0078d4" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBox x:Name="AddSubTaskTextBox" 
                                                     Background="Transparent" 
                                                     BorderThickness="0"
                                                     FontSize="14"
                                                     Foreground="#0078d4"
                                                     Visibility="Collapsed"
                                                     KeyDown="AddSubTaskInput_KeyDown"
                                                     LostFocus="AddSubTaskInput_LostFocus"
                                                     MinWidth="150"
                                                     VerticalAlignment="Center">
                                                <TextBox.Resources>
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                    <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 备注区（背景框） -->
                                <Border Background="#222" CornerRadius="8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- 备注工具栏 -->
                                        <Grid Grid.Row="0" Padding="12,8,8,4" HorizontalAlignment="Right">
                                            <Button x:Name="InsertLinkButton"
                                                    Click="InsertLink_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                                    ToolTipService.ToolTip="插入链接">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="#0078d4"/>
                                                    <TextBlock Text="链接" FontSize="12" Foreground="#0078d4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <!-- 备注文本框 -->
                                        <TextBox Grid.Row="1"
                                                 x:Name="DetailDescription"
                                                 PlaceholderText="添加备注..."
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#ccc"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="100"
                                                 Padding="12,0,12,12"
                                                 TextChanged="DetailDescription_TextChanged"
                                                 KeyDown="DetailDescription_KeyDown"
                                                 RightTapped="DetailDescription_RightTapped">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#666"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <!-- 设置区（背景框） -->
                                <Border Background="#222" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 截止日期 -->
                                        <Grid Height="48" Padding="12,0">
                                            <Button x:Name="DueDateButton" 
                                                    Click="ShowDueDatePicker_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="#888"/>
                                                    <TextBlock x:Name="DueDateText" Text="截止日期" Foreground="#ccc" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearDueDateButton" 
                                                    Click="ClearDueDate_Click"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#666"/>
                                            </Button>
                                        </Grid>
                                        <CalendarView x:Name="DetailCalendarView" 
                                                            HorizontalAlignment="Stretch"
                                                            Language="zh-CN"
                                                            SelectedDatesChanged="DetailCalendarView_SelectedDatesChanged"
                                                            Visibility="Collapsed">
                                            <CalendarView.Resources>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="#0078D4"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="#FFFFFF"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="#168DE2"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="#006CBE"/>
                                                <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                            </CalendarView.Resources>
                                        </CalendarView>
                                        
                                        <!-- 提醒我 -->
                                        <Grid Height="48" Padding="12,0" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0">
                                            <Button x:Name="ReminderButton" 
                                                    Click="ShowReminderDialog_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="#888"/>
                                                    <TextBlock x:Name="ReminderText" Text="提醒我" Foreground="#ccc" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <Button x:Name="RecurringReminderButton" 
                                                        Click="ToggleRecurringReminder_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Visibility="Collapsed">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="#0078d4"/>
                                                </Button>
                                                <Button x:Name="ClearReminderButton" 
                                                        Click="ClearReminder_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Visibility="Collapsed">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#666"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 提醒设置弹窗 -->
                                        <Border x:Name="ReminderSettingsPanel" 
                                                Background="#252525" 
                                                CornerRadius="8" 
                                                Padding="12"
                                                Visibility="Collapsed"
                                                Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="选择提醒日期" FontSize="13" Foreground="#888" Margin="0,0,0,8"/>
                                                <CalendarView x:Name="ReminderCalendarView"
                                                              HorizontalAlignment="Stretch"
                                                              Language="zh-CN"
                                                              SelectionMode="Multiple"
                                                              SelectedDatesChanged="ReminderCalendarView_SelectedDatesChanged">
                                                    <CalendarView.Resources>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="#0078D4"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="#FFFFFF"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="#168DE2"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="#006CBE"/>
                                                        <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                                    </CalendarView.Resources>
                                                </CalendarView>
                                                <TextBlock x:Name="ReminderSelectedDatesText"
                                                           Text="未选择日期"
                                                           FontSize="12"
                                                           Foreground="#BDBDBD"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                                
                                                <TextBlock Text="提醒时间" FontSize="13" Foreground="#888" Margin="0,12,0,8" />
                                                <TimePicker x:Name="ReminderTimePicker" HorizontalAlignment="Stretch"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" >
                                                    <TextBlock Text="重复提醒" FontSize="13" Foreground="#888" VerticalAlignment="Center" />
                                                    <ToggleSwitch x:Name="EnableSameDayReminderToggle"
                                                                  Toggled="EnableSameDayReminderToggle_Toggled"
                                                                  OnContent=""
                                                                  OffContent=""
                                                                  MinWidth="0"
                                                                  Width="50"
                                                                  Margin="8,0"/>
                                                    <TextBlock Text="|" FontSize="13" Foreground="#888" VerticalAlignment="Center" />
                                                    <TextBlock Text="提醒频率" FontSize="13" Foreground="#888" VerticalAlignment="Center" Margin="8,0,8,0" />
                                                    <ComboBox x:Name="SameDayIntervalComboBox"
                                                              Width="120"
                                                              IsEnabled="False"
                                                              SelectionChanged="SameDayIntervalComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="10分钟" Tag="10"/>
                                                        <ComboBoxItem Content="20分钟" Tag="20"/>
                                                        <ComboBoxItem Content="30分钟" Tag="30"/>
                                                        <ComboBoxItem Content="1小时" Tag="60"/>
                                                        <ComboBoxItem Content="2小时" Tag="120"/>
                                                        <ComboBoxItem Content="3小时" Tag="180"/>
                                                        <ComboBoxItem Content="5小时" Tag="300"/>
                                                        <ComboBoxItem Content="6小时" Tag="360"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Right" 
                                                            Margin="0,16,0,0">
                                                    <Button Content="取消" 
                                                            Margin="0,0,8,0" 
                                                            Click="CancelReminderSettings_Click"
                                                            Background="#333"
                                                            BorderThickness="0"/>
                                                    <Button Content="确认" 
                                                            Background="#0078d4"
                                                            Foreground="White"
                                                            Click="ConfirmReminderSettings_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- 重复 -->
                                        <Grid Height="48" Padding="12,0" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0">
                                            <Button x:Name="RecurrenceButton" 
                                                    Click="ShowRecurrenceMenu_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="#888"/>
                                                    <TextBlock x:Name="RecurrenceText" Text="重复" Foreground="#ccc" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearRecurrenceButton" 
                                                    Click="ClearRecurrence_Click"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#666"/>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- 标记为重要 -->
                                        <Grid Height="48" Padding="12,0" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#888"/>
                                                <TextBlock Text="标记为重要" Foreground="#ccc" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ImportantToggle" 
                                                          OnContent="" OffContent=""
                                                          MinWidth="0" Width="50"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Toggled="ImportantToggle_Toggled"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>

        <!-- 紧凑模式：固定桌面小窗口 -->
        <Grid x:Name="CompactContent" Grid.Row="1" Background="#1e1e1e" Visibility="Collapsed"  >
            <Grid x:Name="DummyTitleBar" Height="0" Width="0" VerticalAlignment="Top" HorizontalAlignment="Left"  />
            
            <Grid Padding="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 紧凑模式标题栏 -->
                <Grid Grid.Row="0" Height="38" PointerPressed="CompactTitle_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="T O  D O" 
                               Grid.Column="0"
                               FontSize="18" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Click="ToggleDesktopMode_Click" 
                            Background="Transparent" 
                            Margin="0,0,12,0"
                            BorderThickness="0" 
                            Padding="4"
                            ToolTipService.ToolTip="恢复正常窗口">
                        <FontIcon Glyph="&#xE196;" FontSize="14" Foreground="#888"/>
                    </Button>
                </Grid>

                <!-- 紧凑模式任务列表 -->
                <ScrollViewer x:Name="CompactScrollViewer" Grid.Row="1">
                    <StackPanel>
                        <ItemsControl x:Name="CompactTasksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,0,12,6">
                                        <Border BorderBrush="#333" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Background="#262626"
                                                Padding="10,8">
                                            <StackPanel>
                                                <Grid MinHeight="28">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" Margin="4,0,0,0"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding DueDateDisplay}" 
                                                               HorizontalAlignment="Right" 
                                                               VerticalAlignment="Center" 
                                                               Foreground="#666" 
                                                               FontSize="11"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SubTasks, Mode=OneWay}" Margin="24,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="26" Margin="0,2,0,0">
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#aaa" FontSize="12"/>
                                                                </CheckBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="CompactCompletedButton" 
                                Margin="12,10,0,10" 
                                Background="#262626" 
                                BorderThickness="0" 
                                CornerRadius="4" 
                                Padding="12,6" 
                                Click="CompactToggleCompleted_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="#888"/>
                                <TextBlock x:Name="CompactCompletedText" Text="已完成" FontSize="12" Foreground="#888"/>
                                <FontIcon x:Name="CompactCompletedArrow" Glyph="&#xE70D;" FontSize="10" Foreground="#888"/>
                            </StackPanel>
                        </Button>

                        <ItemsControl x:Name="CompactCompletedTasksList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <Border BorderBrush="#333"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Background="#262626"
                                                Opacity="0.6"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid MinHeight="28">
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                            <TextBlock Text="{Binding Title}" TextDecorations="Strikethrough" Foreground="#888" FontSize="13" Margin="4,0,0,0"/>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding DueDateDisplay}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#555"
                                                                   FontSize="11"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding SubTasks, Mode=OneWay}" Margin="24,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="26" Margin="0,2,0,0">
                                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   TextDecorations="Strikethrough"
                                                                                   Foreground="#666"
                                                                                   FontSize="12"/>
                                                                    </CheckBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <Rectangle Grid.Column="1"
                                                           Fill="{Binding CompletionIndicatorBrush}"
                                                           VerticalAlignment="Stretch"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,2"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 展开/收起按钮 -->
                <Button x:Name="CompactToggleButton" 
                        Grid.Row="2" 
                        Click="CompactToggle_Click"
                        Visibility="Visible"
                        HorizontalAlignment="Stretch"
                        Background="#262626"
                        BorderThickness="1"
                        BorderBrush="#333"
                        CornerRadius="0"
                        Padding="0,8"
                        Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon x:Name="CompactToggleIcon" Glyph="&#xE96E;" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
