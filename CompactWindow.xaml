<Window
    x:Class="Todo.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Todo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#1e1e1e">
        <Grid Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="38" PointerPressed="TitleBar_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="T O  D O"
                           Grid.Column="0"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Click="RestoreButton_Click"
                        Background="Transparent"
                        Margin="0,0,12,0"
                        BorderThickness="0"
                        Padding="4"
                        ToolTipService.ToolTip="恢复正常窗口">
                    <FontIcon Glyph="&#xE196;" FontSize="14" Foreground="#888"/>
                </Button>
            </Grid>

            <!-- 任务列表 -->
            <ScrollViewer x:Name="CompactScrollViewer" Grid.Row="1">
                <StackPanel>
                    <ItemsControl x:Name="CompactTasksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,0,12,6">
                                    <Border BorderBrush="#333"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="#262626">
                                        <Grid>
                                            <Rectangle Fill="{Binding DueUrgencyBackground}" RadiusX="6" RadiusY="6"/>
                                            <StackPanel Margin="10,8">
                                                <Grid MinHeight="28">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" Margin="4,0,0,0"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding DueDateDisplay}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="#afff"
                                                               FontSize="11"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SubTasks, Mode=OneWay}" Margin="24,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="26" Margin="0,2,0,0">
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#dddd" FontSize="12"/>
                                                                </CheckBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="CompactCompletedButton"
                            Margin="12,10,0,10"
                            Background="#262626"
                            BorderThickness="0"
                            CornerRadius="4"
                            Padding="12,6"
                            Click="ToggleCompleted_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="#888"/>
                            <TextBlock x:Name="CompactCompletedText" Text="已完成" FontSize="12" Foreground="#888"/>
                            <FontIcon x:Name="CompactCompletedArrow" Glyph="&#xE70D;" FontSize="10" Foreground="#888"/>
                        </StackPanel>
                    </Button>

                    <ItemsControl x:Name="CompactCompletedTasksList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <Border BorderBrush="#333"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="#262626"
                                            Opacity="0.6">
                                        <Grid>
                                            <Rectangle Fill="{Binding DueUrgencyBackground}" RadiusX="6" RadiusY="6"/>
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid MinHeight="28">
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="TaskCheckBox_Click">
                                                            <TextBlock Text="{Binding Title}" TextDecorations="Strikethrough" Foreground="#888" FontSize="13" Margin="4,0,0,0"/>
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding DueDateDisplay}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#555"
                                                                   FontSize="11"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding SubTasks, Mode=OneWay}" Margin="24,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="26" Margin="0,2,0,0">
                                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   TextDecorations="Strikethrough"
                                                                                   Foreground="#666"
                                                                                   FontSize="12"/>
                                                                    </CheckBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <Rectangle Grid.Column="1"
                                                           Fill="{Binding CompletionIndicatorBrush}"
                                                           VerticalAlignment="Stretch"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,2"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 展开/收起按钮 -->
            <Button x:Name="CompactToggleButton"
                    Grid.Row="2"
                    Click="ToggleExpand_Click"
                    Visibility="Visible"
                    HorizontalAlignment="Stretch"
                    Background="#262626"
                    BorderThickness="1"
                    BorderBrush="#333"
                    CornerRadius="0"
                    Padding="0,8"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon x:Name="CompactToggleIcon" Glyph="&#xE96E;" FontSize="12" Foreground="#888"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
