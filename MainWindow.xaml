<Window
    x:Class="Memo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Memo"
    xmlns:models="using:Memo.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftDragColumn" Width="*"/>
                <ColumnDefinition x:Name="ButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <ImageIcon x:Name="TitleBarIcon"
                      Source="ms-appx:///Assets/16x.png"
                      Grid.Column="1"
                      Margin="20,0,8,0"
                       Width="18"
                      VerticalAlignment="Center"/>
            
            <TextBlock x:Name="TitleBarTextBlock" 
                       Text="Memo" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontWeight="SemiBold"/>

            <Grid x:Name="DragRegion" Grid.Column="3"/>

            <Button x:Name="PinButton" Click="ToggleDesktopMode_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    Grid.Column="4"
                    ToolTipService.ToolTip="固定到桌面">
                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Button>
        </Grid>

        <!-- 正常模式：NavigationView 主内容区 -->
        <Grid x:Name="NormalContent" Grid.Row="1">
            <NavigationView x:Name="NavView"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Left"
                            OpenPaneLength="260"
                            CompactPaneLength="60"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            PaneOpening="NavView_PaneOpened"
                            PaneClosing="NavView_PaneClosed"
                            ItemInvoked="NavView_ItemInvoked"
                            SelectionChanged="NavView_SelectionChanged">
                
                <!-- 固定导航项 -->
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="记事本" Tag="Notepad">
                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/icons/white/记事本.svg" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Name="TasksNavItem" Content="任务" Tag="Matrix" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/icons/white/任务列表.svg" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.MenuItems>
                            <NavigationViewItem Content="即时任务" Tag="Important">
                                <NavigationViewItem.Icon>
                                    <ImageIcon Source="ms-appx:///Assets/icons/white/重要任务.svg" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="RecurringNavItem" Content="例行任务" Tag="Recurring" IsExpanded="True">
                                <NavigationViewItem.Icon>
                                    <ImageIcon Source="ms-appx:///Assets/icons/white/例行任务.svg"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>
                    
                    <NavigationViewItemSeparator/>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItemSeparator/>
                </NavigationView.FooterMenuItems>

                <NavigationView.PaneFooter>
                    <Grid x:Name="PaneFooterGrid" Padding="0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewListButton"
                                Grid.Column="0"
                                Click="NewList_Click"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,8"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ImageIcon Source="ms-appx:///Assets/icons/white/新建任务列表.svg" Width="16" Height="16"/>
                                <TextBlock Text="新建列表" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewGroupButton"
                                Grid.Column="1"
                                Click="NewGroup_Click"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,8"
                                CornerRadius="0"
                                HorizontalContentAlignment="Center"
                                Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ImageIcon Source="ms-appx:///Assets/icons/white/新建分组.svg" Width="16" Height="16"/>
                                <TextBlock Text="新建分组" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </NavigationView.PaneFooter>

                <!-- 内容区域 - 使用 SplitView 实现抽屉 -->
                <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主内容区 -->
                    <Grid Grid.Column="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PointerPressed="ContentArea_PointerPressed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 页面标题 -->
                        <StackPanel x:Name="PageHeader" Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="40,20,40,20">
                            <ImageIcon x:Name="PageIcon" Source="ms-appx:///Assets/icons/white/任务列表.svg" Width="28" Height="28"/>
                            <TextBlock x:Name="PageTitle" Text="任务" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <!-- 记事本页面 -->
                        <Grid x:Name="NotepadContent" Grid.Row="1" Visibility="Collapsed" Padding="4,0,2,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TabView 标签栏 -->
                           <TabView x:Name="NotepadTabView"
                                    Grid.Row="0"
                                     AddTabButtonClick="NotepadTabView_AddTabClick"
                                     TabCloseRequested="NotepadTabView_TabCloseRequested"
                                     SelectionChanged="NotepadTabView_SelectionChanged"
                                     SelectedIndex="0"
                                     Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                     IsAddTabButtonVisible="True">
                            </TabView>

                            <!-- 工具栏 -->
                            <Grid x:Name="NotepadToolbar" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                 Padding="8,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：文件操作 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="NotepadOpenButton"
                                            Click="NotepadOpen_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="打开文件">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Button>
                                    <Button x:Name="NotepadSaveButton"
                                            Click="NotepadSave_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="保存">
                                        <FontIcon Glyph="&#xE74E;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Button>
                                    <Button x:Name="NotepadSaveAsButton"
                                            Click="NotepadSaveAs_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="另存为">
                                        <FontIcon Glyph="&#xE792;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>

                                <!-- 右侧：预览/编辑切换 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="NotepadPreviewToggleButton"
                                            Click="NotepadPreviewToggle_Click"
                                            Background="Transparent" BorderThickness="0" Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                            ToolTipService.ToolTip="切换预览/编辑">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon x:Name="NotepadPreviewToggleIcon" Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="NotepadPreviewToggleText" Text="编辑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 编辑器（IsReadOnly 切换预览/编辑） -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <local:NotepadEditTextBox x:Name="NotepadEditor"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                         BorderThickness="0"
                                         Margin="0,0,0,0"
                                         Padding="24,8,24,8"
                                         TextChanged="NotepadEditor_TextChanged">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource TextFillColorTertiary}"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
                                        <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource TextFillColorSecondary}"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource TextFillColorSecondary}"/>
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource TextFillColorSecondary}"/>
                                    </TextBox.Resources>
                                </local:NotepadEditTextBox>
                            </ScrollViewer>

                            <!-- 误关闭恢复提示 -->
                            <Grid x:Name="NotepadUndoBar" Grid.Row="3" Height="36" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="Collapsed" Padding="8,0" CornerRadius="6,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NotepadUndoText" Grid.Column="0" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Button Grid.Column="1" Click="NotepadUndoClose_Click" Background="Transparent" BorderThickness="0" Padding="8,4" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12">
                                    恢复
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- 四象限矩阵 -->
                        <Grid x:Name="MatrixContent" Grid.Row="1" Visibility="Collapsed" Padding="24,0,24,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Q1 重要且紧急 -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="3,0,0,0"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Q1 · 重要且紧急" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="MatrixQ1Count" Text="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="立即处理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Padding="8">
                                        <ItemsControl x:Name="MatrixQ1List" ItemsSource="{x:Bind MatrixQ1Tasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TaskItem">
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                            Height="48" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            PointerPressed="MatrixTask_PointerPressed">
                                                        <Grid Margin="10,0">
                                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind DueDateShortDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MatrixQ1Empty" Grid.Row="1" Text="暂无任务" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Q2 重要不紧急 -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                            BorderThickness="3,0,0,0"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Q2 · 重要不紧急" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="MatrixQ2Count" Text="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="计划安排" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Padding="8">
                                        <ItemsControl x:Name="MatrixQ2List" ItemsSource="{x:Bind MatrixQ2Tasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TaskItem">
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                            Height="48" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            PointerPressed="MatrixTask_PointerPressed">
                                                        <Grid Margin="10,0">
                                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind DueDateShortDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MatrixQ2Empty" Grid.Row="1" Text="暂无任务" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Q3 紧急不重要 -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,6,6,0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                            BorderThickness="3,0,0,0"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Q3 · 紧急不重要" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="MatrixQ3Count" Text="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="快速处理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Padding="8">
                                        <ItemsControl x:Name="MatrixQ3List" ItemsSource="{x:Bind MatrixQ3Tasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TaskItem">
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                            Height="48" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            PointerPressed="MatrixTask_PointerPressed">
                                                        <Grid Margin="10,0">
                                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind DueDateShortDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MatrixQ3Empty" Grid.Row="1" Text="暂无任务" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Q4 可暂缓 -->
                            <Border Grid.Row="1" Grid.Column="1" Margin="6,6,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="3,0,0,0"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Q4 · 可暂缓" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="MatrixQ4Count" Text="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="低优先级" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Padding="8">
                                        <ItemsControl x:Name="MatrixQ4List" ItemsSource="{x:Bind MatrixQ4Tasks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TaskItem">
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                                            Height="48" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            PointerPressed="MatrixTask_PointerPressed">
                                                        <Grid Margin="10,0">
                                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind DueDateShortDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MatrixQ4Empty" Grid.Row="1" Text="暂无任务" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 任务列表 ScrollView -->
                        <ScrollViewer x:Name="TaskListScrollViewer" Grid.Row="1" Padding="40,0,40,0">
                            <StackPanel MinWidth="300" HorizontalAlignment="Stretch">
                                <ItemsControl x:Name="TasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Height="60"
                                                    Margin="0,0,0,10"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    Loaded="TaskBorder_Loaded"
                                                    Unloaded="TaskBorder_Unloaded"
                                                    PointerPressed="TaskItem_PointerPressed"
                                                    PointerEntered="TaskItem_PointerEntered"
                                                    PointerExited="TaskItem_PointerExited"
                                                    RightTapped="TaskItem_RightTapped">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="删除任务" Icon="Delete" Click="DeleteTask_Click"/>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <Grid>
                                                    <Rectangle Fill="{Binding DueUrgencyBackground}" RadiusX="8" RadiusY="8"/>
                                                    <Grid Margin="15,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="180"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Click="TaskCheckBox_Click"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="10,0,0,0">
                                                            <TextBlock FontSize="10" Text="{Binding CreatedAtFullLabel}"
                                                                       Foreground="{Binding DateLabelForeground}"/>
                                                            <TextBlock FontSize="10" Text="{Binding DueDateFullLabel}"
                                                                       Foreground="{Binding DateLabelForeground}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="CompletedButton"
                                        Margin="0,10,0,10" 
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderThickness="0" 
                                        CornerRadius="4" 
                                        Padding="8,4" 
                                        Click="ToggleCompleted_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ImageIcon Source="ms-appx:///Assets/icons/white/已完成.svg" Width="12" Height="12"/>
                                        <TextBlock x:Name="CompletedText" Text="已完成" FontSize="12"/>
                                        <FontIcon x:Name="CompletedArrow" Glyph="&#xE70D;" FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl x:Name="CompletedTasksList" Visibility="Collapsed" Opacity="0">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform x:Name="CompletedListTransform" Y="0"/>
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Height="60"
                                                    Margin="0,0,0,10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    Opacity="0.6"
                                                    Loaded="TaskBorder_Loaded"
                                                    Unloaded="TaskBorder_Unloaded"
                                                    PointerPressed="TaskItem_PointerPressed"
                                                    PointerEntered="TaskItem_PointerEntered"
                                                    PointerExited="TaskItem_PointerExited"
                                                    RightTapped="TaskItem_RightTapped">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="删除任务" Icon="Delete" Click="DeleteTask_Click"/>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <Grid>
                                                    <Rectangle Fill="{Binding DueUrgencyBackground}" RadiusX="8" RadiusY="8"/>
                                                    <Grid Margin="15,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="176"/>
                                                            <ColumnDefinition Width="4"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Click="TaskCheckBox_Click"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   TextDecorations="Strikethrough"
                                                                   Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="10,0,0,0">
                                                            <TextBlock FontSize="10" Text="{Binding CreatedAtFullLabel}"
                                                                       Foreground="{Binding DateLabelForeground}"/>
                                                            <TextBlock FontSize="10" Text="{Binding DueDateFullLabel}"
                                                                       Foreground="{Binding DateLabelForeground}"/>
                                                        </StackPanel>
                                                        <Rectangle Grid.Column="3"
                                                                   Fill="{Binding CompletionIndicatorBrush}"
                                                                   VerticalAlignment="Stretch"
                                                                   RadiusX="2" RadiusY="2"
                                                                   Margin="0,2"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 固定底部 - 添加任务 -->
                        <Grid x:Name="AddTaskBar" Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="40,10,40,10">
                            <Grid x:Name="AddTaskContainer">
                                <!-- 按钮状态 -->
                                <Border x:Name="AddTaskButton" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Height="60"
                                        HorizontalAlignment="Stretch"
                                        Visibility="Visible">
                                    <Button Click="ShowAddTaskInput_Click" 
                                            HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Stretch" 
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                            BorderThickness="0" 
                                            HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0">
                                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="添加任务" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                
                                <!-- 输入框状态 -->
                                <Border x:Name="AddTaskInputArea"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="60"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Visibility="Collapsed">
                                    <Grid Margin="22,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ImageIcon Grid.Column="0" Source="ms-appx:///Assets/icons/white/任务列表.svg" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBox x:Name="AddTaskTextBox"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="14"
                                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="12,0"
                                                 KeyDown="AddTaskInput_KeyDown"
                                                 LostFocus="AddTaskTextBox_LostFocus">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="2"
                                                x:Name="AddTaskRecurrenceButton"
                                                Click="AddTaskRecurrence_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="设置重复">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon x:Name="AddTaskRecurrenceIcon"
                                                          Glyph="&#xE8EE;"
                                                          FontSize="22"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock x:Name="AddTaskRecurrenceText"
                                                           Text=""
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3"
                                                x:Name="AddTaskDueDateButton"
                                                Click="AddTaskDueDate_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6,4" AllowFocusOnInteraction="False" IsTabStop="False"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="设置截止日期">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ImageIcon x:Name="AddTaskDueDateIcon" Source="ms-appx:///Assets/icons/white/日历.svg" Width="22" Height="22"/>
                                                <TextBlock x:Name="AddTaskDueDateText"
                                                           Text=""
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Grid Padding="12" RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <CalendarView x:Name="AddTaskCalendarView"
                                                                      Grid.Row="0"
                                                                      Language="zh-CN"
                                                                      SelectedDatesChanged="AddTaskCalendarView_SelectedDatesChanged">
                                                            <CalendarView.Resources>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="{ThemeResource SystemAccentColor}"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="{ThemeResource SystemAccentColorLight1}"/>
                                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                                <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                                            </CalendarView.Resources>
                                                        </CalendarView>
                                                        <Button Grid.Row="1"
                                                                Content="清除日期"
                                                                Click="AddTaskClearDate_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                FontSize="12"
                                                                HorizontalAlignment="Right"
                                                                Padding="8,4"/>
                                                    </Grid>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 右侧抽屉 - 任务详情 -->
                    <Grid x:Name="DetailDrawer" 
                          Grid.Column="1" 
                          Margin="0,6"
                          Width="380"
                          Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                          BorderThickness="1,1,1,1"
                          CornerRadius="8,0,0,8"
                          Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DrawerTranslateTransform" X="380"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 抽屉标题 -->
                        <Grid Grid.Row="0" Height="32" Padding="16,8,16,0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,0">
                            
                            <Button Click="CloseDrawer_Click" 
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- 抽屉内容 -->
                        <ScrollViewer Grid.Row="1" Padding="16" x:Name="DrawerScrollViewer">
                            <StackPanel Spacing="0">
                                <!-- 任务标题（无背景） -->
                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8,8,0,0" Padding="8,8,8,0">
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  x:Name="DetailCheckBox" 
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  Click="DetailCheckBox_Click"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="DetailTitle" 
                                             Background="Transparent" 
                                             BorderThickness="0"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                             Padding="0"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             TextChanged="DetailTitle_TextChanged">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                        </TextBox.Resources>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <ScrollViewer x:Name="ContentElement"
                                                                              VerticalScrollMode="Auto"
                                                                              VerticalScrollBarVisibility="Hidden"
                                                                              HorizontalScrollMode="Disabled"
                                                                              HorizontalScrollBarVisibility="Hidden"
                                                                              Padding="{TemplateBinding Padding}"
                                                                              Foreground="{TemplateBinding Foreground}"
                                                                              AutomationProperties.AccessibilityView="Raw"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <!-- 子任务区（背景框） -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,8,8" Padding="8" Margin="0,0,0,12" MinHeight="50">
                                    <StackPanel Spacing="0">
                                        <!-- 子任务列表 -->
                                        <ItemsControl x:Name="SubTasksList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,0" MinHeight="28">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                  Click="SubTaskCheckBox_Click"
                                                                  RightTapped="SubTask_RightTapped"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Title, Mode=TwoWay}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 FontSize="13"
                                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                 Padding="0,0,0,0"
                                                                 Margin="8,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 TextChanged="SubTaskTitle_TextChanged"
                                                                 LostFocus="SubTaskTitle_LostFocus">
                                                            <TextBox.Resources>
                                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                                                <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                                            </TextBox.Resources>
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="TextBox">
                                                                                <Grid>
                                                                                    <ScrollViewer x:Name="ContentElement"
                                                                                                  VerticalScrollMode="Auto"
                                                                                                  VerticalScrollBarVisibility="Hidden"
                                                                                                  HorizontalScrollMode="Disabled"
                                                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                                                  Padding="{TemplateBinding Padding}"
                                                                                                  Foreground="{TemplateBinding Foreground}"
                                                                                                  AutomationProperties.AccessibilityView="Raw"/>
                                                                                </Grid>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CreatedAtDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"/>
                                                        <Button Grid.Column="3"
                                                                Click="DeleteSubTask_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- 添加子任务按钮/输入框 -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="AddSubTaskButton" 
                                                    Click="ShowAddSubTaskInput_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ImageIcon Source="ms-appx:///Assets/icons/white/任务列表.svg" Width="22" Height="18"/>
                                                    <TextBlock Text="添加子任务" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.8" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBox x:Name="AddSubTaskTextBox" 
                                                     Background="Transparent" 
                                                     BorderThickness="0"
                                                     FontSize="14"
                                                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                     Visibility="Collapsed"
                                                     KeyDown="AddSubTaskInput_KeyDown"
                                                     LostFocus="AddSubTaskInput_LostFocus"
                                                     MinWidth="150"
                                                     VerticalAlignment="Center">
                                                <TextBox.Resources>
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                    <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 备注区（背景框） -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 关联记事本行 -->
                                        <Grid x:Name="LinkedNotepadBar" Grid.Row="0" Height="36" Padding="12,0,12,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="LinkNotepadButton"
                                                    Click="LinkNotepadButton_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,6"
                                                    HorizontalAlignment="Left"
                                                    ToolTipService.ToolTip="关联记事本">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock x:Name="LinkNotepadButtonText" Text="关联记事本" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed" x:Name="LinkedNotepadInfo">
                                                <FontIcon Glyph="&#xE167;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock x:Name="LinkedNotepadName" Text=""  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    x:Name="UnlinkNotepadButton"
                                                    Click="UnlinkNotepadButton_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8,6"
                                                    Visibility="Collapsed"
                                                    ToolTipService.ToolTip="取消关联">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                            </Button>
                                        </Grid>

                                        <!-- 备注文本框 -->
                                        <TextBox x:Name="DetailDescription"
                                                 Grid.Row="1"
                                                 PlaceholderText=""
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="36"
                                                 Height="36"
                                                 Padding="12,8,12,8"
                                                 TextChanged="DetailDescription_TextChanged"
                                                 SizeChanged="DetailDescription_SizeChanged"
                                                 KeyDown="DetailDescription_KeyDown"
                                                 RightTapped="DetailDescription_RightTapped">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource TextFillColorDisabled}"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <!-- 设置区（背景框） -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <!-- 截止日期 -->
                                        <Grid Height="48" Padding="12,0">
                                            <Button x:Name="DueDateButton" 
                                                    Click="ShowDueDatePicker_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ImageIcon Source="ms-appx:///Assets/icons/white/日历888.svg" Width="16" Height="16"/>
                                                    <TextBlock x:Name="DueDateText" Text="截止日期" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearDueDateButton" 
                                                    Click="ClearDueDate_Click"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                            </Button>
                                        </Grid>
                                        <CalendarView x:Name="DetailCalendarView" 
                                                            HorizontalAlignment="Stretch"
                                                            Language="zh-CN"
                                                            SelectedDatesChanged="DetailCalendarView_SelectedDatesChanged"
                                                            Visibility="Collapsed">
                                            <CalendarView.Resources>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="{ThemeResource SystemAccentColor}"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="{ThemeResource SystemAccentColorLight1}"/>
                                                <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                            </CalendarView.Resources>
                                        </CalendarView>
                                        
                                        <!-- 提醒我 -->
                                        <Grid Height="48" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Button x:Name="ReminderButton" 
                                                    Click="ShowReminderDialog_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock x:Name="ReminderText" Text="提醒我" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <ToggleButton x:Name="DeadlineReminderToggle"
                                                              Click="DeadlineReminderToggle_Click"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="4"
                                                              Visibility="Collapsed"
                                                              ToolTipService.ToolTip="截止日提醒">
                                                    <FontIcon Glyph="&#xEE93;" FontSize="18"/>
                                                </ToggleButton>
                                                <Button x:Name="RecurringReminderButton"
                                                        Click="ToggleRecurringReminder_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Visibility="Collapsed">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </Button>
                                                <Button x:Name="ClearReminderButton" 
                                                        Click="ClearReminder_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Visibility="Collapsed">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 提醒设置弹窗 -->
                                        <Border x:Name="ReminderSettingsPanel" 
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                CornerRadius="8" 
                                                Padding="12"
                                                Visibility="Collapsed"
                                                Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="选择提醒日期" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,8"/>
                                                <CalendarView x:Name="ReminderCalendarView"
                                                              HorizontalAlignment="Stretch"
                                                              Language="zh-CN"
                                                              SelectionMode="Multiple"
                                                              SelectedDatesChanged="ReminderCalendarView_SelectedDatesChanged">
                                                    <CalendarView.Resources>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBackground" Color="{ThemeResource SystemAccentColor}"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedForeground" Color="White"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedHoverBackground" Color="{ThemeResource SystemAccentColorLight1}"/>
                                                        <SolidColorBrush x:Key="CalendarViewCalendarItemSelectedPressedBackground" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                        <x:Double x:Key="CalendarViewCalendarItemBorderThemeThickness">2</x:Double>
                                                    </CalendarView.Resources>
                                                </CalendarView>
                                                <TextBlock x:Name="ReminderSelectedDatesText"
                                                           Text="未选择日期"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                                
                                                <TextBlock Text="提醒时间" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,12,0,8" />
                                                <TimePicker x:Name="ReminderTimePicker" HorizontalAlignment="Stretch"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" >
                                                    <TextBlock Text="重复提醒" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                    <ToggleSwitch x:Name="EnableSameDayReminderToggle"
                                                                  Toggled="EnableSameDayReminderToggle_Toggled"
                                                                  OnContent=""
                                                                  OffContent=""
                                                                  MinWidth="0"
                                                                  Width="50"
                                                                  Margin="8,0"/>
                                                    <TextBlock Text="|" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="提醒频率" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,8,0" />
                                                    <ComboBox x:Name="SameDayIntervalComboBox"
                                                              Width="120"
                                                              IsEnabled="False"
                                                              SelectionChanged="SameDayIntervalComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="10分钟" Tag="10"/>
                                                        <ComboBoxItem Content="20分钟" Tag="20"/>
                                                        <ComboBoxItem Content="30分钟" Tag="30"/>
                                                        <ComboBoxItem Content="1小时" Tag="60"/>
                                                        <ComboBoxItem Content="2小时" Tag="120"/>
                                                        <ComboBoxItem Content="3小时" Tag="180"/>
                                                        <ComboBoxItem Content="5小时" Tag="300"/>
                                                        <ComboBoxItem Content="6小时" Tag="360"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Right" 
                                                            Margin="0,16,0,0">
                                                    <Button Content="取消" 
                                                            Margin="0,0,8,0" 
                                                            Click="CancelReminderSettings_Click"
                                                            Background="{ThemeResource SolidBackgroundFillColorQuinaryBrush}"
                                                            BorderThickness="0"/>
                                                    <Button Content="确认"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Click="ConfirmReminderSettings_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- 重复 -->
                                        <Grid Height="48" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Button x:Name="RecurrenceButton" 
                                                    Click="ShowRecurrenceMenu_Click"
                                                    Background="Transparent" 
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8EE;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock x:Name="RecurrenceText" Text="重复" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearRecurrenceButton" 
                                                    Click="ClearRecurrence_Click"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- 优先级 -->
                                        <StackPanel Padding="12,8,12,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Spacing="8">
                                            <TextBlock Text="优先级" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <Grid Height="92" Margin="0,0,0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="18"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="紧急" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="不紧急" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="重要" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="次要" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <Button x:Name="QuadrantQ1Button" Grid.Row="1" Grid.Column="1" Tag="Q1" Click="QuadrantPicker_Click"
                                                        Content="Q1" FontSize="11" MinHeight="32" Margin="2" Padding="4,2"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                <Button x:Name="QuadrantQ2Button" Grid.Row="1" Grid.Column="2" Tag="Q2" Click="QuadrantPicker_Click"
                                                        Content="Q2" FontSize="11" MinHeight="32" Margin="2" Padding="4,2"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                <Button x:Name="QuadrantQ3Button" Grid.Row="2" Grid.Column="1" Tag="Q3" Click="QuadrantPicker_Click"
                                                        Content="Q3" FontSize="11" MinHeight="32" Margin="2" Padding="4,2"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                <Button x:Name="QuadrantQ4Button" Grid.Row="2" Grid.Column="2" Tag="Q4" Click="QuadrantPicker_Click"
                                                        Content="Q4" FontSize="11" MinHeight="32" Margin="2" Padding="4,2"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </Grid>

                                            <Grid Height="36" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="重要" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="ImportantSlider" Grid.Column="1"
                                                        Minimum="0" Maximum="1" StepFrequency="1"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="ImportantSlider_ValueChanged"/>
                                                <TextBlock x:Name="ImportantLevelText" Grid.Column="2" Text="低" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="紧急" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="UrgentSlider" Grid.Column="4"
                                                        Minimum="0" Maximum="1" StepFrequency="1"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="UrgentSlider_ValueChanged"/>
                                                <TextBlock x:Name="UrgentLevelText" Grid.Column="5" Text="低" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="UrgencyAutoHint" Text="本周内截止视为紧急" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                                <Button x:Name="ResetUrgencyAutoButton"
                                                        Content="恢复自动"
                                                        Click="ResetUrgencyAuto_Click"
                                                        Visibility="Collapsed"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
